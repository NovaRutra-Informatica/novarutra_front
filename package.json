{
  "name": "novarutra-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "ng deploy --base-href=/ --cname=novarutra.com.br",
    "format": "npx prettier . --write",
    "build:fa": "node scripts/build-fa-subset.mjs",
    "build:images": "node scripts/optimize-images.mjs",
    "build:assets": "npm run build:fa && npm run build:images"
  },
  "prettier": {
    "printWidth": 80,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/common": "^21.2.9",
    "@angular/compiler": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/platform-browser": "^21.2.9",
    "@angular/platform-server": "^21.2.9",
    "@angular/router": "^21.2.9",
    "@angular/service-worker": "^21.2.9",
    "@angular/ssr": "^21.2.7",
    "@emailjs/browser": "^4.4.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.9",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@types/node": "^20.17.19",
    "fontawesome-subset": "^4.6.0",
    "jsdom": "^27.1.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
