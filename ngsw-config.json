{
    "$schema": "./node_modules/@angular/service-worker/config/schema.json",
    "index": "/index.html",
    "assetGroups": [
        {
            "name": "app-shell",
            "installMode": "prefetch",
            "updateMode": "prefetch",
            "resources": {
                "files": [
                    "/index.html",
                    "/index.csr.html",
                    "/manifest.webmanifest",
                    "/*.css",
                    "/*.js"
                ]
            }
        },
        {
            "name": "fonts",
            "installMode": "prefetch",
            "updateMode": "prefetch",
            "resources": {
                "files": ["/assets/fonts/**/*.(woff|woff2)"]
            }
        },
        {
            "name": "hero-lcp",
            "installMode": "prefetch",
            "updateMode": "prefetch",
            "resources": {
                "files": [
                    "/assets/hero/image1-*.webp",
                    "/assets/hero/image1-*.avif"
                ]
            }
        },
        {
            "name": "assets",
            "installMode": "lazy",
            "updateMode": "prefetch",
            "resources": {
                "files": [
                    "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf)"
                ]
            }
        }
    ]
}
