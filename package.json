{
  "name": "novarutra-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "ng deploy --base-href=/ --cname=novarutra.com.br",
    "format": "bunx prettier . --write",
    "build:fa": "node scripts/build-fa-subset.mjs",
    "build:images": "node scripts/optimize-images.mjs",
    "build:assets": "bun run build:fa && bun run build:images"
  },
  "prettier": {
    "printWidth": 80,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/service-worker": "^22.2.6",
    "@angular/ssr": "^22.2.7",
    "@emailjs/browser": "^5.0.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@types/node": "^26.6.6",
    "fontawesome-subset": "^4.6.0",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "lmdb",
    "msgpackr-extract"
  ]
}
